# Babylon RL Training Configuration
# Supports: CUDA GPU, Apple Silicon (MLX), CPU, W&B Serverless

# === REQUIRED ===
DATABASE_URL=postgresql://user:password@localhost:5432/babylon

# === BACKEND SELECTION ===
# If none set, auto-detects: CUDA > MLX > CPU
# Set ONE of these to true to force a specific backend:

# USE_MLX_BACKEND=true      # Apple Silicon Mac (fastest on Mac)
# USE_LOCAL_BACKEND=true    # CUDA GPU (auto-falls back to MLX/CPU if no CUDA)
# USE_CPU_BACKEND=true      # CPU only (SLOW - not recommended)
# Set WANDB_API_KEY for W&B Serverless (cloud training)

# === W&B SERVERLESS (Cloud Training) ===
# Get from: https://wandb.ai/settings
WANDB_API_KEY=
WANDB_PROJECT=babylon

# === MODEL SELECTION ===
# Leave blank to auto-select based on backend:
# - Serverless: OpenPipe/Qwen3-14B-Instruct
# - CUDA: unsloth/Qwen3-4B-128K
# - MLX: mlx-community/Qwen2.5-3B-Instruct-4bit
# - CPU: unsloth/Qwen3-4B-128K

# Recommended models by backend:
# BASE_MODEL=unsloth/Qwen3-4B-128K           # CUDA (128K context, efficient)
# BASE_MODEL=mlx-community/Qwen2.5-3B-Instruct-4bit  # MLX (4-bit, fast)
# BASE_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit  # MLX (larger, better quality)
# BASE_MODEL=OpenPipe/Qwen3-14B-Instruct     # Serverless (only option in W&B catalog)

BASE_MODEL=

# === TRAINING CONFIG ===
MIN_AGENTS_PER_WINDOW=1
MODE=single
# WINDOW_ID=              # Specific window to train (optional)
# MAX_EXAMPLES=2000       # Limit trajectories
# MAX_STEPS_PER_TRAJECTORY=20
# LEARNING_RATE=1e-5
# MAX_SEQ_LENGTH=8192     # Context length (reduce for low memory)

# === NOT NEEDED ===
# OPENPIPE_API_KEY - Not used! (local scoring)
# WANDB_ENTITY - Auto-handled by backend
