# Babylon RL Training Configuration

# === REQUIRED ===
DATABASE_URL=postgresql://user:password@localhost:5432/babylon
# TRAIN_RL_LOCAL - Not used! (ServerlessBackend requires WANDB_API_KEY)

# === REQUIRED FOR TRAINING ===
# W&B API Key (REQUIRED - ServerlessBackend only supports W&B remote training)
# Get from: https://wandb.ai/settings
WANDB_API_KEY=

# W&B Project
WANDB_PROJECT=babylon-rl

# Training config
MIN_AGENTS_PER_WINDOW=3
# CRITICAL: Only model available in W&B ART catalog
BASE_MODEL=OpenPipe/Qwen3-14B-Instruct
MODE=single

# === NOT NEEDED ===
# OPENPIPE_API_KEY - Not used! (local scoring)
# WANDB_ENTITY - Not used! (ServerlessBackend handles it)
# TRAIN_RL_LOCAL - Not used! (ServerlessBackend requires WANDB_API_KEY)
