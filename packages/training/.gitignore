# Training Package Ignores
# (Patterns specific to this package - general patterns in root .gitignore)

# Data exports (keep .gitkeep files)
data/*.csv
data/**/*.parquet
data/**/scored_*.json
!data/**/.gitkeep

# Keep benchmark scenarios (they are deterministic and should be committed)
!data/benchmarks/
!data/benchmarks/scenarios/
!data/benchmarks/scenarios/*.json
!data/benchmarks/scenarios/README.md

# E2E test output
training-data/e2e-test-results.json

# Python logs
python/logs/

# Python test caches (pytest)
python/.pytest_cache/
python/**/.pytest_cache/

#tmp
TRAINING_ROADMAP.mdRUNPOD_QUICKSTART.md
