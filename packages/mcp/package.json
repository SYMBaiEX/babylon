{
  "name": "@babylon/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Babylon MCP Protocol - Model Context Protocol server implementation",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts",
      "require": "./src/types/index.ts"
    },
    "./types/mcp": {
      "types": "./src/types/mcp.ts",
      "import": "./src/types/mcp.ts",
      "require": "./src/types/mcp.ts"
    },
    "./handlers": {
      "types": "./src/handlers/index.ts",
      "import": "./src/handlers/index.ts",
      "require": "./src/handlers/index.ts"
    },
    "./auth": {
      "types": "./src/auth/index.ts",
      "import": "./src/auth/index.ts",
      "require": "./src/auth/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts",
      "require": "./src/server/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts",
      "require": "./src/utils/index.ts"
    }
  },
  "scripts": {
    "lint": "biome lint .",
    "typecheck": "tsc -b ."
  },
  "dependencies": {
    "@babylon/shared": "workspace:*"
  },
  "peerDependencies": {
    "@babylon/db": "workspace:*",
    "@babylon/api": "workspace:*",
    "@babylon/shared": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "ethers": "^6.15.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "bun-types": "^1.3.2",
    "typescript": "^5.9.3"
  }
}

