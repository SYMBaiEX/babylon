{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@babylon/contracts": ["./src/index.ts"],
      "@babylon/contracts/*": ["./src/*"],
      "@babylon/contracts/deployments/local": ["./deployments/local/index.ts"],
      "@babylon/contracts/deployments/base-sepolia": ["./deployments/base-sepolia/index.ts"],
      "@babylon/contracts/deployments/base": ["./deployments/base/index.ts"]
    }
  },
  "include": ["src/**/*", "deployments/**/*.ts", "deployments/**/*.json"],
  "exclude": ["node_modules", "dist", "out", "cache"]
}
