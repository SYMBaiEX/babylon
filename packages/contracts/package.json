{
  "name": "@babylon/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Smart contract types and deployment information for Babylon",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts",
      "require": "./src/types.ts"
    },
    "./deployment": {
      "types": "./src/deployment/index.ts",
      "import": "./src/deployment/index.ts",
      "require": "./src/deployment/index.ts"
    },
    "./deployments/local": "./deployments/local/latest.json",
    "./deployments/base-sepolia": "./deployments/base-sepolia/latest.json",
    "./deployments/base": "./deployments/base/latest.json"
  },
  "files": [
    "src",
    "deployments",
    "deployments.d.ts"
  ],
  "scripts": {
    "lint": "biome lint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "ethers": "^6.15.0",
    "viem": "^2.30.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
