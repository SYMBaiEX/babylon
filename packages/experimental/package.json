{
  "name": "@babylon/experimental",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Self-contained toy demonstration of permissionless AI game on simulated TEE",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "demo": "bun run src/demo.ts",
    "demo:full": "bun run src/infra/full-demo.ts",
    "demo:costs": "bun run src/infra/full-demo.ts --costs",
    "smoke": "bun run src/infra/smoke-test.ts",
    "test": "bun test src/tests/",
    "test:watch": "bun test --watch src/tests/",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@phala/dstack-sdk": "^0.5.7",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "typescript": "^5.6.3"
  }
}
