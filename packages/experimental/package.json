{
  "name": "@babylon/experimental",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Self-contained permissionless AI game on simulated TEE - fully autonomous",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "bun run src/autonomous/production.ts",
    "demo": "bun run src/demo.ts",
    "demo:auto": "bun run src/automated-demo.ts",
    "demo:autonomous": "bun run src/autonomous/demo.ts",
    "demo:full": "bun run src/infra/full-demo.ts",
    "verify:crypto": "bun run src/verify-crypto.ts",
    "verify:storage": "bun run src/verify-storage.ts",
    "honest": "bun run src/honest-demo.ts",
    "security": "bun run src/security-demo.ts",
    "smoke": "bun run src/infra/smoke-test.ts",
    "deploy:contracts": "forge script script/Deploy.s.sol:Deploy --rpc-url sepolia --broadcast",
    "deploy:ens": "bun run src/infra/ens-deployer.ts",
    "register:ens": "bun run src/infra/ens-registrar.ts",
    "storage:test": "bun run src/infra/real-storage-test.ts",
    "e2e:production": "bun run src/e2e-production-test.ts",
    "serve:frontend": "bun --hot serve frontend/",
    "test": "bun test src/tests/",
    "test:watch": "bun test --watch src/tests/",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "clean": "rm -rf dist out cache"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.6.3"
  }
}
