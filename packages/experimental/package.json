{
  "name": "@babylon/experimental",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Permissionless AI compute marketplace - NO API KEYS, wallet signatures only",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "demo": "node --import=tsx --experimental-require-module src/automated-demo.ts",
    "demo:bun": "bun run src/automated-demo.ts",
    "audit": "bun run src/permissionless-audit.ts",
    "check:wallets": "bun run src/check-wallets.ts",
    "verify:crypto": "bun run src/verify-crypto.ts",
    "verify:storage": "bun run src/verify-storage.ts",
    "verify:arweave": "bun run src/verify-arweave.ts",
    "tee:marlin": "bun run src/test-marlin.ts",
    "tee:marlin:e2e": "bun run src/test-marlin-e2e.ts",
    "tee:marlin:deploy": "bun run src/test-marlin-e2e.ts --deploy",
    "deploy:ens": "bun run src/infra/ens-deployer.ts",
    "register:ens": "bun run src/infra/ens-registrar.ts",
    "storage:test": "bun run src/infra/real-storage-test.ts",
    "bootstrap": "bun run src/infra/bootstrap.ts",
    "test": "bun test src/tests/",
    "test:watch": "bun test --watch src/tests/",
    "test:compute": "bun test src/compute/tests/",
    "compute:node": "bun run src/compute/node/index.ts",
    "compute:demo": "bun run src/compute/scripts/demo.ts",
    "compute:join": "bun run src/compute/scripts/join-network.ts",
    "compute:deploy": "NETWORK=anvil bun run src/compute/scripts/deploy-base.ts",
    "compute:deploy:sepolia": "NETWORK=sepolia bun run src/compute/scripts/deploy-base.ts",
    "compute:deploy:mainnet": "NETWORK=mainnet bun run src/compute/scripts/deploy-base.ts",
    "compute:validate": "bun run src/compute/scripts/validate-deployment.ts",
    "compute:validate:sepolia": "NETWORK=sepolia bun run src/compute/scripts/deploy-base.ts validate",
    "compute:validate:mainnet": "NETWORK=mainnet bun run src/compute/scripts/deploy-base.ts validate",
    "test:mainnet": "bun test src/compute/tests/mainnet.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "clean": "rm -rf dist out cache demo-output babylon-game"
  },
  "dependencies": {
    "arweave": "^1.15.7",
    "ethers": "^6.13.0",
    "gpt-tokenizer": "^3.4.0",
    "hono": "^4.10.7",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@irys/sdk": "^0.2.11",
    "@types/bun": "^1.3.3",
    "bs58": "^6.0.0",
    "typescript": "^5.6.3"
  }
}
