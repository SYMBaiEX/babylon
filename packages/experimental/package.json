{
  "name": "@babylon/experimental",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "100% permissionless AI game - NO API KEYS, wallet signatures only",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "demo": "node --import=tsx --experimental-require-module src/automated-demo.ts",
    "demo:bun": "bun run src/automated-demo.ts",
    "audit": "bun run src/permissionless-audit.ts",
    "check:wallets": "bun run src/check-wallets.ts",
    "verify:crypto": "bun run src/verify-crypto.ts",
    "verify:storage": "bun run src/verify-storage.ts",
    "verify:arweave": "bun run src/verify-arweave.ts",
    "tee:marlin": "bun run src/test-marlin.ts",
    "tee:marlin:e2e": "bun run src/test-marlin-e2e.ts",
    "tee:marlin:deploy": "bun run src/test-marlin-e2e.ts --deploy",
    "tee:phala": "bun run src/test-phala.ts",
    "deploy:ens": "bun run src/infra/ens-deployer.ts",
    "register:ens": "bun run src/infra/ens-registrar.ts",
    "storage:test": "bun run src/infra/real-storage-test.ts",
    "bootstrap": "bun run src/infra/bootstrap.ts",
    "test": "bun test src/tests/",
    "test:watch": "bun test --watch src/tests/",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "clean": "rm -rf dist out cache demo-output babylon-game"
  },
  "dependencies": {
    "@phala/cloud": "^0.2.0",
    "arweave": "^1.15.7",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@irys/sdk": "^0.2.11",
    "@types/bun": "^1.3.3",
    "bs58": "^6.0.0",
    "typescript": "^5.6.3"
  }
}
