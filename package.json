{
  "name": "babylon",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/examples/*"
  ],
  "scripts": {
    "postinstall": "bun run scripts/postinstall-solidity-deps.ts && bun run scripts/postinstall-install-python-deps.ts",
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=web",
    "dev:next-only": "turbo dev:next-only --filter=web",
    "build": "turbo build",
    "start": "turbo start --filter=web",
    "check": "biome check --write .",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "validate:all": "bun run validate:data && bun run typecheck && bun run lint",
    "validate:data": "bun run scripts/validate-all-data.ts",
    "test": "act -W .github/workflows/local-ci.yml",
    "test:direct": "bun run test:unit && bun run test:integration",
    "test:fast": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test packages/testing/unit/ --preload ./packages/testing/unit/preload.ts",
    "test:integration": "bun test packages/testing/integration/ --preload ./packages/testing/integration/preload.ts",
    "test:all": "act -W .github/workflows/local-ci.yml",
    "test:act": "act -W .github/workflows/local-ci.yml",
    "test:act:ci": "act -W .github/workflows/ci-tests.yml",
    "test:act:list": "act -l",
    "test:retry": "bun test src/lib/__tests__/db-retry.integration.test.ts",
    "test:a2a": "bun test src/a2a/tests/",
    "test:a2a:unit": "bun test ./src/a2a/tests/integration/points-service-integration.test.ts",
    "test:a2a:live": "bun run src/a2a/tests/live-server.test.ts",
    "test:plugin": "bun test packages/testing/integration/babylon-plugin-complete.test.ts",
    "test:testnet": "bun test packages/testing/deployment/testnet.test.ts packages/testing/integration/agent0-testnet.test.ts",
    "test:localnet": "bun test packages/testing/integration/agent0-localnet.test.ts packages/testing/deployment/localnet.test.ts",
    "test:mainnet": "bun test packages/testing/deployment/mainnet.test.ts",
    "test:e2e": "cd packages/testing && playwright test e2e && playwright test --config=synpress.config.ts",
    "test:ci": "bash scripts/ci/run-all-tests.sh",
    "test:playwright": "cd packages/testing && playwright test e2e",
    "test:synpress": "cd packages/testing && playwright test --config=synpress.config.ts",
    "test:logout": "cd packages/testing && playwright test --config=synpress.config.ts synpress/08-logout-verification.spec.ts",
    "test:logout:headed": "cd packages/testing && playwright test --config=synpress.config.ts synpress/08-logout-verification.spec.ts --headed",
    "miniapp:validate": "bun run scripts/test-miniapp-manifest.ts",
    "miniapp:deploy": "bash scripts/deploy-miniapp.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:seed": "bun run scripts/seed-test-data.ts all",
    "deploy:local": "bun run scripts/deployment/deploy-localnet.ts",
    "deploy:testnet": "bun run scripts/deployment/deploy-testnet.ts",
    "deploy:mainnet": "bun run scripts/deployment/deploy-mainnet.ts",
    "hardhat": "cd packages/contracts && npx hardhat node",
    "contracts:setup": "rm -rf packages/contracts/dependencies && bun run scripts/postinstall-solidity-deps.ts",
    "contracts:test": "cd packages/contracts && forge test",
    "contracts:test:oracle": "cd packages/contracts && forge test --match-contract BabylonGameOracleTest",
    "contracts:deploy:local": "bun run scripts/deployment/deploy-localnet.ts",
    "oracle:test:simple": "./scripts/test-oracle-simple.sh",
    "oracle:test:e2e": "bun test packages/testing/integration/oracle-full-flow.test.ts",
    "oracle:test:betting": "bun test packages/testing/integration/betting/ packages/testing/e2e/betting-on-chain.test.ts",
    "oracle:test:integration": "bun test packages/testing/integration/oracle/",
    "oracle:deploy-and-test": "./scripts/deploy-and-test-full.sh",
    "agent0:setup": "bun run scripts/agent0/configure-agent0.ts",
    "admin": "bun run scripts/admin.ts",
    "status": "bun run scripts/status.ts",
    "game:start": "bun run scripts/game-control-db.ts start",
    "game:pause": "bun run scripts/game-control-db.ts pause",
    "game:status": "bun run scripts/game-control-db.ts status",
    "db:start": "bun run scripts/db.ts start",
    "db:stop": "bun run scripts/db.ts stop",
    "db:status": "bun run scripts/db.ts status",
    "testnet:setup": "bun run scripts/post-deploy/testnet-setup.ts",
    "cli:validate": "bun run apps/cli/src/validate-actors.ts",
    "cli:images": "bun run apps/cli/src/generate-actor-images.ts",
    "cli:images:migrate": "bun run apps/cli/src/migrate-images-to-blob.ts",
    "cli:simulate": "bun run apps/cli/src/run-game.ts",
    "cli:simulate:batch": "bun run apps/cli/src/run-game.ts --count=100 --fast",
    "cli:world": "bun run apps/cli/src/generate-world.ts",
    "cli:world:verbose": "bun run apps/cli/src/generate-world.ts --verbose",
    "cli:generate": "bun run apps/cli/src/generate-game.ts",
    "cli:generate:verbose": "bun run apps/cli/src/generate-game.ts --verbose",
    "rl:harness": "tsx scripts/run-rl-harness.ts",
    "hf:collect": "tsx scripts/collect-game-data-for-hf.ts",
    "hf:upload": "tsx scripts/upload-to-huggingface.ts",
    "hf:verify": "tsx scripts/verify-hf-upload.ts",
    "hf:offline": "tsx scripts/run-offline-simulation.ts",
    "hf:test-flow": "tsx scripts/test-hf-complete-flow.ts",
    "stress-test": "bun run scripts/run-load-test.ts",
    "stress-test:a2a": "bun run scripts/run-a2a-stress-test.ts",
    "stress-test:a2a:light": "bun run scripts/run-a2a-stress-test.ts light",
    "stress-test:a2a:normal": "bun run scripts/run-a2a-stress-test.ts normal",
    "stress-test:a2a:heavy": "bun run scripts/run-a2a-stress-test.ts heavy",
    "stress-test:a2a:rate-limit": "bun run scripts/run-a2a-stress-test.ts rate-limit",
    "stress-test:a2a:coalition": "bun run scripts/run-a2a-stress-test.ts coalition",
    "load-test:comprehensive": "bun run scripts/load-test/comprehensive-load-test.ts",
    "load-test:comprehensive:local": "bun run scripts/load-test/comprehensive-load-test.ts local",
    "load-test:comprehensive:staging": "bun run scripts/load-test/comprehensive-load-test.ts staging",
    "load-test:quick": "bun run scripts/load-test/quick-route-test.ts",
    "load-test:extreme": "bun run scripts/load-test/extreme-stress-test.ts",
    "load-test:100k": "bun run scripts/load-test/extreme-stress-test.ts local",
    "load-test:validate": "bun run scripts/validate-load-testing-system.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.44.7",
    "ethers": "^6.15.0",
    "import-in-the-middle": "1.15.0",
    "ioredis": "^5.8.2",
    "openai": "^6.8.1",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "require-in-the-middle": "7.5.2",
    "viem": "^2.38.6",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@prb/math": "^4.1.0",
    "@playwright/test": "^1.56.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.0",
    "bun-types": "^1.3.2",
    "concurrently": "^9.2.1",
    "csv-parse": "^6.1.0",
    "hardhat": "2.22.18",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "tsx": "^4.20.6",
    "turbo": "^2.5.4",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "packageManager": "bun@1.3.0"
}
