{
  "name": "babylon-docs",
  "version": "1.0.0",
  "description": "Documentation for Babylon",
  "private": true,
  "scripts": {
    "dev": "bunx next dev -p 3001",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' bunx next build",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
    "start": "bunx next start",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "generate:api-docs": "tsx scripts/generate-api-docs.ts",
    "generate:tsdoc": "typedoc",
    "generate:deployment-docs": "tsx scripts/generate-deployment-docs.ts",
    "generate:contract-abis": "tsx scripts/generate-contract-abis.ts",
    "generate:all": "bun run generate:api-docs && bun run generate:tsdoc && bun run generate:deployment-docs && bun run generate:contract-abis",
    "check:links": "tsx scripts/check-links.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "autoprefixer": "^10.4.22",
    "next": "^16.0.3",
    "nextra": "^4.6.0",
    "nextra-theme-docs": "^4.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "pagefind": "^1.4.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-react": "^5.30.2",
    "tsx": "^4.20.6",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.9.3",
    "zod-validation-error": "^5.0.0"
  },
  "overrides": {
    "zod-validation-error": "^5.0.0"
  }
}
